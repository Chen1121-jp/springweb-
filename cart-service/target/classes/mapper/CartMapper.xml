<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.digital.mall.cart.mapper.CartMapper">

    <update id="updateNum">
        UPDATE cart.cart
        SET num = num + 1
        WHERE item_id = #{itemId}
          AND user_id = #{userId}
    </update>

</mapper>
